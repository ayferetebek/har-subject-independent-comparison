      "max_depth": "12",
      "max_features": "None",
      "min_samples_leaf": "5"
    },
    "Random Forest": {
      "criterion": "gini",
      "max_depth": "None",
      "max_features": "sqrt",
      "min_samples_leaf": "3",
      "n_estimators": "300"
    },
    "Gradient Boosting": {
      "l2_regularization": "0.0",
      "learning_rate": "0.1",
      "max_depth": "None",
      "max_features": "1.0",
      "max_iter": "200",
      "min_samples_leaf": "20"
    }
  },
  "runtime_seconds": 2380.5
