{
  "env": {
    "python": "3.13.18",
    "numpy": "2.1.3",
    "pandas": "2.2.3",
    "scikit-learn": "1.6.1",
    "scipy": "1.16.3",
    "seed": 42
  },
  "settings": {
    "FAST_MODE": false,
    "N_FOLDS": 10,
    "N_REPEATS": 3,
    "N_BOOT": 2000,
